{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(ssh *10.0.0.1*)",
      "Bash(ssh root@*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/change-window.sh\" status --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/op-rotate\" ] && python3 -I \"$HOME/.local/bin/op-rotate\" status --hook || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "unifi-network@unifi-plugins": true
  }
}
