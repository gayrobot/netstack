# Copy to .env and fill in. .env is gitignored and Claude is told never to read it.

# UniFi controller (UDM Pro)
UNIFI_NETWORK_HOST=10.0.0.1
UNIFI_NETWORK_PORT=443
UNIFI_NETWORK_SITE=default
UNIFI_NETWORK_USERNAME=
# Prefer a password command (e.g. macOS Keychain) over a plaintext value:
#   security find-generic-password -a <user> -s unifi-network -w
UNIFI_NETWORK_PASSWORD=
UNIFI_NETWORK_VERIFY_SSL=false

# Keep every mutation policy off during Phase 1
UNIFI_POLICY_NETWORK_CREATE=false
UNIFI_POLICY_NETWORK_UPDATE=false
UNIFI_POLICY_NETWORK_DELETE=false
UNIFI_NETWORK_TOOL_PERMISSION_MODE=confirm

# Hosts (real names go in .env only)
APP_VM_SSH_HOST=
APP_VM_SSH_USER=
